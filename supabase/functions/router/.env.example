# Copy relevant values to Supabase secrets (npx supabase secrets set --project-ref <ref> KEY=VALUE)
# and to the local backend .env if running the Node server.

# Resend API key for transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@lightraildeals.com
RESEND_FROM_NAME=Light Rail Deals

# Optional Mapbox access token for server-side address geocoding.
MAPBOX_ACCESS_TOKEN=
