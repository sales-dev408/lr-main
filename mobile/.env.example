# Mapbox runtime token used by the nearby participating businesses map.
# Provide a public token (pk.ey...) and optional platform-specific tokens.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN_IOS=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN_ANDROID=

# Optional Mapbox style URLs. Falls back to the default Mapbox Standard style.
EXPO_PUBLIC_MAPBOX_STYLE_URL=
EXPO_PUBLIC_MAPBOX_STYLE_URL_IOS=
EXPO_PUBLIC_MAPBOX_STYLE_URL_ANDROID=

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
